# ── Required in production ───────────────────────────────────────────────────
# PostgreSQL connection string. Leave unset in development to use the embedded
# PGlite database stored in ./.data (no services to install).
DATABASE_URL=postgres://asterpanel:change-me@localhost:5432/asterpanel

# Encrypts stored secrets (server credentials, gateway keys). Generate once and
# never change it:  openssl rand -hex 32
APP_SECRET=

# Bearer token for the billing cron endpoint (POST /api/cron).
CRON_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
# Public origin. Only needed when the reverse proxy does not forward Host.
# APP_URL=https://billing.example.com

# When set, the /install wizard asks for this value before creating the admin.
# INSTALL_TOKEN=
